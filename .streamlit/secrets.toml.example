# =============================================================================
# Ejemplo de secrets — copiar a .streamlit/secrets.toml (LOCAL) o a
# Streamlit Cloud → Settings → Secrets (NUBE). NUNCA subir al repositorio.
# =============================================================================

[supabase]
url = "postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-TU-REGION.pooler.supabase.com:5432/postgres"

# Secreto para firmar las cookies de sesión (recordar sesión).
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
[session]
secret = "CAMBIA-ESTE-SECRETO-ALEATORIO"

# Google OAuth ("Continuar con Google"):
#   1) Google Cloud Console → APIs y servicios → Credenciales → Crear credenciales
#      → ID de cliente OAuth → tipo "Aplicación web"
#   2) Authorized redirect URI: https://TU-APP.streamlit.app/
#   3) Pega aquí client_id y client_secret (o en .env_google_oauth local)
[google_oauth]
client_id = ""
client_secret = ""
