# Plantilla de secretos para Streamlit Community Cloud
# 1) Copia este bloque en Streamlit Cloud → tu app → Settings → Secrets
# 2) Sustituye por TU connection string de Supabase:
#    Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# [supabase]
# url = "postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-TU-REGION.pooler.supabase.com:5432/postgres"
